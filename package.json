{
  "name": "form-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "biome:check": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write --unsafe --assist-enabled=true .",
    "lint": "biome lint .",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm run biome:check && pnpm run lint && pnpm run typecheck",
    "ready": "pnpm run format && pnpm run fix && pnpm run check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
